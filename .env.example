# TomatoLite 环境变量模板（S0-3 交付物，v0.7 §0.6）。
# 用法：cp .env.example .env 后按需填真值。base.py 对所有项**零默认值**——
# 缺任何一行，`manage.py check` 必须失败（这是防真密钥进 git 的负断言）。
# 本文件永远不放真凭据。

# ---- Django 核心 ----
SECRET_KEY=change-me-random-40-chars

# ---- 数据库（§0.6a：本地 MacPorts PG≥15，非容器，F-8 起；测试库由 runner 自建）----
DATABASE_URL=postgres://postgres@localhost:5432/tomatolite_dev

# ---- Redis / Celery（§0.5 队列拓扑；compose 起服务时 host 改 `redis`）----
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# ---- 外部系统三态（§6 第 2 条：业务代码零分支，差异只在本文件的 base_url）----
INTEGRATION_MODE=mock

# GitLab（通道 A：代提交 + webhook 旁听，§4）
GITLAB_BASE_URL=http://localhost:8929
GITLAB_TOKEN=placeholder-token
GITLAB_WEBHOOK_SECRET=placeholder-webhook-secret

# Jenkins（通道 A：触发 + 回调 HMAC 验签，§3）
JENKINS_BASE_URL=http://localhost:8920
JENKINS_USER=placeholder-user
JENKINS_TOKEN=placeholder-token
JENKINS_CALLBACK_HMAC_KEY=placeholder-hmac-key

# S0-9 临时联调栈 seed 位（docker-compose.integration.yml 插值 + s0_9_bootstrap.py 回写；
# 栈随 down -v 作废，值是本机一次性口令——永不入 git；HMAC 位复用上方 JENKINS_CALLBACK_HMAC_KEY）
TL_S09_GITLAB_ROOT_PASSWORD=change-me-s09-only
# s09ops（bootstrap 建的 Jenkins 管理员）口令位：供"人在看"走 UI；值只回写 .env
TL_S09_JENKINS_PASSWORD=change-me-s09-only

# IM 确认闭环凭据位（OQ-4；真实凭据 S0-9 临时联调时填充）
WECOM_CORP_SECRET=placeholder
DINGTALK_APP_SECRET=placeholder

# K8s 只读口径（OQ-3：api=只读SA / kubectl=走 SshTransport）
K8S_READER=api

# 仅 prod.py 需要：DJANGO_ALLOWED_HOSTS=tl.example.com
# 仅 prod.py 需要（Sentry，M1 装配启用）：SENTRY_DSN=
